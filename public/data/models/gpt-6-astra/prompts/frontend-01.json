  "modelOutput": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#263e32\">\n  <meta name=\"description\" content=\"Ledgerleaf is local-first CSA billing for small farms. Keep track of shares, payments, and pickup days without losing your Sunday to a spreadsheet.\">\n  <title>Ledgerleaf — A little order for a growing season.</title>\n  <style>\n    /*\n      Typography: Georgia / Palatino for warm, editorial headlines;\n      Trebuchet MS / Gill Sans for friendly, practical interface text;\n      Courier New for ledger figures and field-note labels.\n      All fonts are local system fonts. No downloads required.\n    */\n    :root {\n      --paper: #f4f0e4;\n      --cream: #fffdf5;\n      --ink: #263e32;\n      --muted: #586351;\n      --line: #c7c9b5;\n      --leaf: #dce4bb;\n      --orange: #b64326;\n      --yellow: #edc365;\n      --serif: Georgia, \"Palatino Linotype\", Palatino, serif;\n      --sans: \"Trebuchet MS\", \"Gill Sans\", sans-serif;\n      --mono: \"Courier New\", Courier, monospace;\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; scroll-padding-top: 6rem; }\n    body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); line-height: 1.6; }\n    a { color: inherit; text-underline-offset: .2em; }\n    button, input { font: inherit; }\n    a, summary { -webkit-tap-highlight-color: transparent; }\n    :focus-visible { outline: 3px solid var(--orange); outline-offset: 5px; }\n    ::selection { background: var(--yellow); color: var(--ink); }\n    h1, h2, h3, p { margin: 0; }\n    h1, h2, h3 { font-family: var(--serif); font-weight: 400; line-height: 1.05; }\n    .wrap { width: min(1180px, calc(100% - 64px)); margin-inline: auto; }\n    .eyebrow { font-family: var(--mono); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercas