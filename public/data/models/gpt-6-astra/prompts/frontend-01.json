4px; align-items: center; margin-top: 30px; }\n    .text-link { font-size: .9rem; }\n    .small-note { margin-top: 15px; font-size: .78rem; color: var(--muted); }\n\n    .ledger-stage { position: relative; padding: 34px 16px 36px; }\n    .ledger-stage::before { content: \"\"; position: absolute; inset: 5px -10px 4px 10px; background: var(--leaf); border-radius: 48% 48% 3px 3px; }\n    .ledger { position: relative; background: var(--cream); border: 1px solid var(--ink); box-shadow: 8px 8px 0 rgba(38,62,50,.12); transform: rotate(-2deg); }\n    .ledger-head { padding: 26px 25px 21px; border-bottom: 1px solid var(--ink); }\n    .ledger-meta { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-family: var(--mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .05em; }\n    .ledger h2 { margin-top: 16px; font-size: 2rem; letter-spacing: -.04em; }\n    .ledger-sub { font-size: .8rem; margin-top: 7px; }\n    .ledger table { width: 100%; border-collapse: collapse; font-size: .79rem; }\n    .ledger th, .ledger td { text-align: left; padding: 15px 12px; border-bottom: 1px solid var(--line); }\n    .ledger th:first-child, .ledger td:first-child { padding-left: 25px; }\n    .ledger th:last-child, .ledger td:last-child { padding-right: 25px; text-align: right; }\n    .ledger th { font-family: var(--mono); font-size: .65rem; font-weight: 400; text-transform: uppercase; }\n    .ledger td:nth-child(2) { font-family: var(--mono); }\n    .status { display: inline-block; padding: 2px 7px; background: var(--leaf); font-size: .68rem; white-space: nowrap; }\n    .status.due { background: #f7dfad; }\n    .ledger-total { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 22px 25px; }\n    .ledger-total span { font-family: var(--mono); font-size: .7rem; text-transform: uppercase; }\n    .ledger-total strong { font-family: var(--serif); font-weight: 400; font-size: 2.1rem; }\n    .ledger-foot { padding: 11px 25px; background: var(--ink); color: var(--cream); font-family: var(--mono); font-size: .65rem; }\n    .field-note { position: relative; width: fit-content; margin: 23px 0 0 auto; font-family: var(--serif); font-style: italic; font-size: 1.15rem; transform: rotate(-4deg); }\n    .field-note span { color: var(--orange); }\n\n    .principles { border-block: 1px solid var(--ink); }\n    .principles .wrap { display: grid; grid-template-columns: repeat(3, 1fr); }\n    .principles p { padding: 22px 20px; font-size: .86rem; text-align: center; }\n    .principles p + p { border-left: 1px solid var(--line); }\n    .principles span { margin-right: 10px; color: var(--orange); font-family: var(--mono); font-size: .75rem; }\n    .section { padding-block: 85px; }\n    .section-heading { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 50px; margin-bottom: 42px; }\n    .section-heading h2, .faq h2 { font-size: clamp(2.4rem, 4vw, 3.5rem); letter-spacing: -.05em; margin-top: 15px; }\n    .section-heading > p { color: var(--muted); max-width: 390px; }\n    .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }\n    .feature { border-top: 2px solid var(--ink); padding-top: 22px; }\n    .feature-number { font-family: var(--mono); font-size: .75rem; color: var(--orange); }\n    .feature h3 { font-size: 1.65rem; margin: 30px 0 16px; letter-spacing: -.03em; }\n    .feature p { font-size: .95rem; color: var(--muted); max-width: 310px; }\n\n    .local { display: grid; grid-template-columns: .8fr 1.2fr; background: var(--ink); color: var(--paper); }\n    .local-art { display: flex; align-items: center; justify-content: center; padding: 30px; border-right: 1px solid #6b7e63; }\n    .local-art svg { width: min(100%, 290px); height: auto; }\n    .local-copy { padding: 48px; }\n    .local h2 { font-size: clamp(2rem, 3.8vw, 3.1rem); letter-spacing: -.045em; margin-block: 18px; }\n    .local-copy > p:last-child { max-width: 440px; color: #d9decf; }\n    .local .eyebrow { color: var(--yellow); }\n\n    .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n    .plan { display: flex; flex-direction: column; position: relative; border: 1px solid var(--ink); padding: 28px; background: var(--cream); }\n    .plan.featured { background: var(--leaf); }\n    .plan-label { min-height: 25px; font-family: var(--mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }\n    .plan h3 { font-size: 2rem; margin-top: 14px; }\n    .plan-description { font-size: .85rem; color: var(--muted); margin-top: 10px; }\n    .price { display: flex; align-items: baseline; gap: 8px; padding-block: 22px; }\n    .price strong { font-family: var(--serif); font-size: 3.4rem; line-height: 1; font-weight: 400; letter-spacing: -.06em; }\n    .price span { font-size: .8rem; color: var(--muted); }\n    .plan ul { list-style: none; padding: 18px 0 26px; margin: 0; border-top: 1px solid var(--line); font-size: .86rem; }\n    .plan li { padding-block: 5px; }\n    .plan li::before { content: \"+\"; color: var(--orange); font-family: var(--mono); margin-right: 10px; }\n    .plan .button { margin-top: auto; }\n    .pricing-note { text-align: center; font-size: .8rem; color: var(--muted); margin-top: 23px; }\n\n    .faq { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; padding-block: 72px 85px; border-top: 1px solid var(--ink); }\n    .faq-intro > p:last-child { color: var(--muted); margin-top: 22px; max-width: 280px; }\n    details { border-bottom: 1px solid var(--line); }\n    details:first-child { border-top: 1px solid var(--line); }\n    summary { position: relative; cursor: pointer; list-style: none; padding: 22px 35px 22px 0; font-size: 1rem; font-weight: 700; }\n    summary::-webkit-details-marker { display: none; }\n    summary::after { content: \"+\"; position: absolute; right: 4px; top: 19px; font-family: var(--mono); font-size: 1.3rem; color: var(--orange); }\n    details[open] summary::after { content: \"−\"; }\n    details p { padding: 0 30px 23px 0; font-size: .93rem; color: var(--muted); }\n    .closing { background: var(--yellow); border-block: 1px solid var(--ink); }\n    .closing .wrap { display: flex; justify-content: space-between; align-items: center; gap: 30px; padding-block: 38px; }\n    .closing h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); letter-spacing: -.04em; }\n    .closing p { font-size: .9rem; margin-top: 8px; }\n    footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; align-items: center; padding-block: 30px; }\n    footer p { color: var(--muted); font-size: .75rem; }\n    footer .brand { font-size: 1.4rem; }\n\n    @media (max-width: 900px) {\n      .hero { gap: 28px; padding-block: 55px; }\n      .ledger-stage { padding-inline: 0; }\n      .ledger th, .ledger td { padding-inline: 8px; }\n      .ledger th:first-child, .ledger td:first-child { padding-left: 14px; }\n      .ledger th:last-child, .ledger td:last-child { padding-right: 14px; }\n      .plan { padding: 20px; }\n      .faq { gap: 35px; }\n    }\n    @media (max-width: 700px) {\n      .wrap { width: calc(100% - 36px); }\n      nav { min-height: 72px; gap: 12px; }\n      .brand { font-size: 1.65rem; }\n      .nav-links { gap: 14px; font-size: .8rem; }\n      .nav-how { display: none; }\n      .nav-links .button { padding: .45rem .65rem; font-size: .76rem; }\n      .hero { grid-template-columns: 1fr; gap: 32px; padding-block: 44px; }\n      h1 { font-size: clamp(3.5rem, 12vw, 5rem); max-width: 520px; }\n      .intro { max-width: 470px; }\n      .ledger-stage { width: min(100% - 14px, 450px); margin-inline: auto; }\n      .principles .wrap { grid-template-columns: 1fr; }\n      .principles p { padding: 12px; text-align: left; }\n      .principles p + p { border-left: 0; border-top: 1px solid var(--line); }\n      .section { padding-block: 58px; }\n      .section-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 30px; }\n      .features, .pricing-grid { grid-template-columns: 1fr; gap: 24px; }\n      .feature h3 { margin-top: 16px; }\n      .feature p { max-width: none; }\n      .local { grid-template-columns: 1fr; }\n      .local-art { border-right: 0; border-bottom: 1px solid #6b7e63; padding: 20px; }\n      .local-art svg { width: 200px; }\n      .local-copy { padding: 30px 24px; }\n      .plan { padding: 26px; }\n      .faq { grid-template-columns: 1fr; padding-block: 50px; gap: 30px; }\n      .closing .wrap { align-items: flex-start; flex-direction: column; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition: none !important; animation: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"skip\" href=\"#main\">Skip to content</a>\n\n  <header>\n    <nav class=\"wrap\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Ledgerleaf home\">\n        <svg viewBox=\"0 0 30 36\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M15 33V12M15 23C4 24 2 16 3 9c8 0 13 5 12 14ZM15 16C14 7 19 2 27 2c1 8-3 14-12 14Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n        </svg>\n        Ledgerleaf\n      </a>\n      <div class=\"nav-links\">\n        <a class=\"nav-how\" href=\"#how-it-works\">How it works</a>\n        <a href=\"#pricing\">Pricing</a>\n        <a class=\"button\" href=\"#get-started\">Get in touch <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </nav>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"hero wrap\" aria-labelledby=\"hero-title\">\n      <div>\n        <p class=\"eyebrow\">For farms that feed their neighbors</p>\n        <h1 id=\"hero-title\">Good growing.<br>Less <em>owing.</em></h1>\n        <p class=\"intro\">CSA billing with both feet on the ground. Keep shares, payments, and pickup lists in order—then get back outside.</p>\n        <div class=\"hero-actions\">\n          <a class=\"button\" href=\"#pricing\">Find your farm’s fit <span aria-hidden=\"true\">↗</span></a>\n          <a class=\"text-link\" href=\"#how-it-works\">Take a look around</a>\n        </div>\n        <p class=\"small-note\">Local-first. Yours to keep. Built for the whole season.</p>\n      </div>\n\n      <div class=\"ledger-stage\">\n        <section class=\"ledger\" aria-label=\"Illustrative farm ledger\">\n          <div class=\"ledger-head\">\n            <div class=\"ledger-meta\"><span>Ledgerleaf / sample ledger</span><span>No. 024</span></div>\n            <h2>Earlybird Farm</h2>\n            <p class=\"ledger-sub\">Summer shares · Week 06 of 20</p>\n          </div>\n          <table>\n            <caption class=\"eyebrow\" style=\"text-align:left;padding:16px 25px 0;font-size:.65rem;\">This week’s installments</caption>\n            <thead><tr><th scope=\"col\">Member</th><th scope=\"col\">Amount</th><th scope=\"col\">Status</th></tr></thead>\n            <tbody>\n              <tr><td>Jordan Ellis</td><td>$32.00</td><td><span class=\"status\">Paid</span></td></tr>\n              <tr><td>Sam Rivera</td><td>$48.00</td><td><span class=\"status\">Paid</span></td></tr>\n              <tr><td>Alex Chen</td><td>$32.00</td><td><span class=\"status due\">Due Friday</span></td></tr>\n              <tr><td>Casey Brooks</td><td>$48.00</td><td><span class=\"status\">Paid</span></td></tr>\n            </tbody>\n          </table>\n          <div class=\"ledger-total\"><span>Collected this week</span><strong>$128.00</strong></div>\n          <div class=\"ledger-foot\">Saved on this device · Ready for the farm stand</div>\n        </section>\n        <p class=\"field-note\"><span aria-hidden=\"true\">↖</span> A tidy ledger. A lighter Sunday.</p>\n      </div>\n    </section>\n\n    <div class=\"principles\">\n      <div class=\"wrap\">\n        <p><span>01</span> Your records live on your device.</p>\n        <p><span>02</span> Your season sets the schedule.</p>\n        <p><span>03</span> Your harvest stays the main event.</p>\n      </div>\n    </div>\n\n    <section class=\"section wrap\" id=\"how-it-works\" aria-labelledby=\"how-title\">\n      <div class=\"section-heading\">\n        <div>\n          <p class=\"eyebrow\">A simpler kind of farm work</p>\n          <h2 id=\"how-title\">From first signup<br>to last squash.</h2>\n        </div>\n        <p>One clear place for the business side of your CSA. Less cross-checking tabs. More knowing where things stand.</p>\n      </div>\n      <div class=\"features\">\n        <article class=\"feature\">\n          <span class=\"feature-number\">01 / SET YOUR SEASON</span>\n          <h3>A share for every table.</h3>\n          <p>Full shares, half shares, a dozen eggs on the side. Set up your offerings and bring your member list along.</p>\n        </article>\n        <article class=\"feature\">\n          <span class=\"feature-number\">02 / KEEP THE BOOKS</span>\n          <h3>Know what’s paid.<br>And what isn’t.</h3>\n          <p>Track upfront payments and installments together. Record cash, checks, and payments received elsewhere without a second spreadsheet.</p>\n        </article>\n        <article class=\"feature\">\n          <span class=\"feature-number\">03 / PACK &amp; PICK UP</span>\n          <h3>Make Friday feel easy.</h3>\n          <p>Turn your share list into a pickup list. Print it, bring it to the stand, and give every member the right box.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"local wrap\" aria-labelledby=\"local-title\">\n      <div class=\"local-art\">\n        <svg viewBox=\"0 0 300 230\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M30 196h240M45 204h210M60 212h180\" stroke=\"#6b7e63\" stroke-width=\"1.5\"/>\n          <rect x=\"54\" y=\"78\" width=\"192\" height=\"114\" rx=\"4\" stroke=\"#f4f0e4\" stroke-width=\"2\"/>\n          <path d=\"M68 178V92h164v86H68ZM34 192h232l-10 8H44l-10-8Z\" stroke=\"#f4f0e4\" stroke-width=\"2\"/>\n          <path d=\"M150 151V51m0 39c-27 0-39-18-38-39 23 0 39 15 38 39Zm0-24c-2-24 15-42 39-43 2 25-14 43-39 43Z\" stroke=\"#edc365\" stroke-width=\"2.5\"/>\n          <path d=\"M94 160h112M94 151h27m58 0h27\" stroke=\"#6b7e63\" stroke-width=\"1.5\"/>\n          <path d=\"M83 32v12m-6-6h12m129 10v12m-6-6h12\" stroke=\"#edc365\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <div class=\"local-copy\">\n        <p class=\"eyebrow\">Rooted here. Stored here.</p>\n        <h2>The internet can take<br>the afternoon off.</h2>\n        <p>Your ledger lives on your computer, so checking a balance or updating a share doesn’t depend on a signal. Export your records and keep a backup somewhere safe. Your member list belongs with you.</p>\n      </div>\n    </section>\n\n    <section class=\"section wrap\" id=\"pricing\" aria-labelledby=\"pricing-title\">\n      <div class=\"section-heading\">\n        <div>\n          <p class=\"eyebrow\">Room to grow</p>\n          <h2 id=\"pricing-title\">Small farm.<br>Fair-sized bill.</h2>\n        </div>\n        <p>Choose by the size of your CSA. Every tier includes offline records, pickup lists, and data export.</p>\n      </div>\n      <div class=\"pricing-grid\">\n        <article class=\"plan\">\n          <p class=\"plan-label\">For the first few rows</p>\n          <h3>Seedling</h3>\n          <p class=\"plan-description\">A simple start for a small CSA.</p>\n          <p class=\"price\"><strong>$0</strong><span>/ month</span></p>\n          <ul>\n            <li>Up to 20 active members</li>\n            <li>One season at a time</li>\n            <li>Share &amp; payment tracking</li>\n            <li>Printable pickup lists</li>\n          </ul>\n          <a class=\"button light\" href=\"mailto:hello@ledgerleaf.example?subject=Seedling%20plan%20inquiry\">Ask about Seedling <span aria-hidden=\"true\">↗</span></a>\n        </article>\n        <article class=\"plan featured\">\n          <p class=\"plan-label\">For a well-established patch</p>\n          <h3>Market Garden</h3>\n          <p class=\"plan-description\">More members. Same clear ledger.</p>\n          <p class=\"price\"><strong>$15</strong><span>/ month</span></p>\n          <ul>\n            <li>Up to 150 active members</li>\n            <li>Everything in Seedling</li>\n            <li>Flexible installment schedules</li>\n            <li>Multiple pickup locations</li>\n          </ul>\n          <a class=\"button\" href=\"mailto:hello@ledgerleaf.example?subject=Market%20Garden%20plan%20inquiry\">Ask about Market Garden <span aria-hidden=\"true\">↗</span></a>\n        </article>\n        <article class=\"plan\">\n          <p class=\"plan-label\">For a thriving operation</p>\n          <h3>Full Acre</h3>\n          <p class=\"plan-description\">Space for your next chapter.</p>\n          <p class=\"price\"><strong>$29</strong><span>/ month</span></p>\n          <ul>\n            <li>Unlimited active members</li>\n            <li>Everything in Market Garden</li>\n            <li>Multiple concurrent seasons</li>\n            <li>Priority email support</li>\n          </ul>\n          <a class=\"button light\" href=\"mailto:hello@ledgerleaf.example?subject=Full%20Acre%20plan%20inquiry\">Ask about Full Acre <span aria-hidden=\"true\">↗</span></a>\n        </article>\n      </div>\n      <p class=\"pricing-note\">Prices in USD. Paid plans billed monthly. Ledgerleaf tracks payments; it doesn’t process them.</p>\n    </section>\n\n    <section class=\"faq wrap\" id=\"faq\" aria-labelledby=\"faq-title\">\n      <div class=\"faq-intro\">\n        <p class=\"eyebrow\">Before you dig in</p>\n        <h2 id=\"faq-title\">Fair questions.<br>Plain answers.</h2>\n        <p>A few things you might want to know before moving the books.</p>\n      </div>\n      <div>\n        <details open>\n          <summary>What does “local-first” actually mean?</summary>\n          <p>Your working records are stored on your device. Core tasks—updating members, recording payments, and preparing pickup lists—work offline. You’re responsible for keeping backups of those records.</p>\n        </details>\n        <details>\n          <summary>Does Ledgerleaf charge my members?</summary>\n          <p>No. Collect payments using the methods that work for your farm, then record them in Ledgerleaf. It helps you see who has paid and what is still due.</p>\n        </details>\n        <details>\n          <summary>Can I bring my spreadsheet?</summary>\n          <p>Yes. Import a CSV member list to get started, and export your records as CSV when you need them elsewhere. You can keep a copy in a format a spreadsheet can read.</p>\n        </details>\n        <details>\n          <summary>What happens if my computer breaks?</summary>\n          <p>Local storage needs a backup plan. Keep a current backup on a separate drive or in a storage service you trust. A copy stored only on the same computer won’t protect against losing that computer.</p>\n        </details>\n        <details>\n          <summary>Is this accounting software?</summary>\n          <p>It’s a focused tool for CSA members, shares, and billing records. Use your accounting tools for the farm’s full books, payroll, and taxes, and export Ledgerleaf records to support that work.</p>\n        </details>\n      </div>\n    </section>\n\n    <section class=\"closing\" id=\"get-started\" aria-labelledby=\"closing-title\">\n      <div class=\"wrap\">\n        <div>\n          <h2 id=\"closing-title\">Leave a little more daylight for the field.</h2>\n          <p>Tell us about your farm. We’ll help you find your fit.</p>\n        </div>\n        <a class=\"button\" href=\"mailto:hello@ledgerleaf.example?subject=My%20farm%20and%20Ledgerleaf\">Let’s talk shares <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"wrap\">\n    <a class=\"brand\" href=\"#\">Ledgerleaf</a>\n    <p>For the people who grow our food.</p>\n    <p>Concept page · Plans illustrative · Contact links use a placeholder address.</p>\n  </footer>\n</body>\n</html>\n",
